# ==============================================================================
# DIGITAL FORTRESS: CLOUDFLARE EDGE HEADERS FOR KUNDAN ARVAANA
# Security Hardening, Anti-Stale Caching & Search Engine Crawler Whitelisting
# ==============================================================================

# Global Edge Security Fortification
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Permitted-Cross-Domain-Policies: none

# Crawler Open Access for Googlebot, Bingbot & Search Engine Verification
/robots.txt
  Content-Type: text/plain; charset=UTF-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all

/sitemap.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all

# Immediate Freshness for HTML documents (Prevents Stale Browser Caching & Black Screens)
/
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/*.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/kundan-arvaana-*
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

# Immutable Long-Term Caching for Static Hashed Assets (Images, Fonts, Scripts, Styles)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
